# Copy to .env and adjust. Never commit real secrets.
EXCELER_ENV=development
EXCELER_HTTP_PORT=8000
EXCELER_DB_NAME=exceler
EXCELER_DB_USER=exceler
EXCELER_LOG_LEVEL=INFO
# Optional development API gate (send as header X-Exceler-Token). Leave empty to disable.
EXCELER_API_DEV_TOKEN=
# Local native development alternative to Compose secrets:
# EXCELER_DB_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://exceler:change-me@localhost:5432/exceler
EXCELER_ALLOWED_SOURCE_ROOTS=/sources
